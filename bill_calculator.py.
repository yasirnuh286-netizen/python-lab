# 1. Ask the user for price and quantity
price_input = input("Enter the price of one item: ")
quantity_input = input("Enter the quantity: ")

# 2. Convert string inputs to numerical values
price = float(price_input)
quantity = int(quantity_input)

# 3. Calculate total cost
total = price * quantity

# 4. Print summary using an f-string formatted to 2 decimal places
print(f"{quantity} items at {price:.2f} each = {total:.2f}")
